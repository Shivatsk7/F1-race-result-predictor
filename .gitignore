# committed and never imported by production code.
spikes/

# NOTE: results/ is deliberately NOT ignored.
# Every performance claim in the README must resolve to a committed
# results file (FR-902, AC-7).

.DS_Store

# graphify knowledge-graph output is generated from the tree it describes.
