# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Collected race data is never committed (FR-107, Constitution VIII.2).
# The repository ships the code to acquire data, not the data.
data/fastf1_cache/
data/raw/
data/processed/

# Trained artifacts are regenerable from committed code + documented collection.
# Anchored to the repo root: unanchored `models/` also matched the
# src/f1pred/models/ source package, silently excluding it from the repo.
/models/
/plots/

# Spikes are throwaway investigation code (Constitution VII.1a). They are never
# committed and never imported by production code.
/spikes/

# NOTE: results/ is deliberately NOT ignored.
# Every performance claim in the README must resolve to a committed
# results file (FR-902, AC-7).

.DS_Store

# setuptools build metadata, regenerated by every editable install.
*.egg-info/

# graphify knowledge-graph output is generated from the tree it describes.
# It is regenerable, churns on every rebuild, and is not project source.
graphify-out/

# Claude Code per-machine settings (permission grants are personal).
.claude/settings.local.json

# OpenSpec's generated Claude Code commands and skills. Regenerated by
# `openspec init`/`openspec update`; the specs themselves live in openspec/.
.claude/commands/opsx/
.claude/skills/openspec-*/

# Kilo Code editor settings (local to this machine).
.kilo/
